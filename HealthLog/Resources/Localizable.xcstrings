        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange das Nährstoff-Modul aus ist, fragt HealthLog Apple Health nicht nach Vitaminen, Mineralstoffen, Wasser und Koffein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the nutrients module is off, HealthLog never asks Apple Health for vitamins, minerals, water or caffeine."
