    "onboarding.mode.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Server bleibt alles auf diesem iPhone. Manche Cloud-Funktionen wie Sync, Insights und Gesundheitsbericht brauchen einen Server. Du kannst ihn später in den Einstellungen verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a server everything stays on this iPhone. Some cloud features, like sync, insights and the doctor report, need a server. You can connect one later in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 없이 쓰면 모든 데이터가 이 iPhone에만 남아요. 동기화, 인사이트, 진료용 리포트 같은 일부 클라우드 기능은 서버가 필요해요. 나중에 설정에서 서버를 연결할 수 있어요."
          }
        }
      }
    },
    "onboarding.mode.server.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräteübergreifend synchronisieren, mit Insights, Health Score, Gesundheitsbericht und Coach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync across devices and unlock insights, Health Score, doctor report and coach."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 기기에서 동기화하고 인사이트, 건강 점수, 진료용 리포트, 코치를 사용할 수 있어요."
          }
        }
      }
    },
