    "anamnesis.state.unreadable.hint": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). Explains the unreadable state and the way out.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist etwas gespeichert, es lässt sich aber nicht entschlüsseln. Wähle einen Wert, um die Angabe neu zu setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
