    "settings.mcp.scope.body": {
      "comment": "1.4 B2-c: MCP screen, body of the card What an assistant can see",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Messwerte, Laborwerte und Medikamente, nur lesend, solange du nicht ausdrücklich mehr erlaubst."
          }
        },
        "en": {
