    "settings.apiTokens.info.about": {
      "comment": "1.4 B2-c: API tokens info sheet, What is this",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du jedes API-Token deines Kontos und kannst es widerrufen. Tokens für die Medikamenten-Erfassung entstehen am Medikament selbst, Tokens für einen externen Assistenten unter MCP-Connector."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This lists every API token on your account and lets you revoke it. Medication ingest tokens are created on the medication itself, tokens for an external assistant under MCP connector."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 계정의 모든 API 토큰이 표시되며 여기서 해지할 수 있어요. 약 수집 토큰은 해당 약에서 만들고, 외부 어시스턴트용 토큰은 MCP 커넥터에서 만들어요."
          }
        }
      }
    },
    "settings.applehealth.ecgSync.footer": {
      "comment": "GH #74 — UI-Standard R2 (Folge): was das Einschalten bewirkt, sonst nichts.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue EKG-Aufzeichnungen samt Kurve gehen an deinen Server. HealthLog liest die Kurve nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New ECG recordings, waveform included, go to your server. HealthLog does not read the waveform."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 심전도 기록이 파형을 포함해 서버로 전송돼요. HealthLog는 파형을 읽지 않아요."
          }
        }
      }
    },
    "settings.applehealth.ecgSync.label": {
      "comment": "GH #74 — Schalter für die EKG-Übernahme aus Apple Health (geräte-lokal, standardmäßig aus).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EKGs aus Apple Health übernehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take ECGs from Apple Health"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health에서 심전도 가져오기"
          }
        }
      }
    },
    "settings.applehealth.medSync.error.unstableExternalId": {
      "comment": "CU-10 — pre-flight refusal when a mirror create carries an unstable externalId",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Apple-Health-Medikament hat keine stabile Kennung und wurde nicht gespiegelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Health medication has no stable identifier and was not mirrored."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple Health 약에는 고정된 식별자가 없어서 미러링하지 않았어요."
          }
        }
      }
    },
    "settings.applehealth.medSync.footer": {
      "comment": "GH #47 — Apple Health medications sync toggle footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegelt deine Apple-Health-Medikamente und protokollierten Dosen (nur lesen). Bei gespiegelten Medikamenten ist die manuelle Dosis-Erfassung deaktiviert, um Doppelzählungen zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror your Apple Health medications and their logged doses (read-only). Manual dose logging is disabled on a mirrored medication to avoid double-counting."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health의 약과 기록된 복용을 미러링해요 (읽기 전용). 중복 집계를 막기 위해 미러링된 약에서는 직접 복용 기록이 비활성화돼요."
          }
        }
      }
    },
    "settings.applehealth.medSync.issue.limitReached": {
      "comment": "CU-10 — Apple Health mirror growth cap reached (server medications.mirror.limit_exceeded)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health enthält mehr Medikamente, als HealthLog spiegelt. Die Obergrenze für gespiegelte Medikamente ist erreicht: Bereits gespiegelte Medikamente werden weiter synchronisiert, neue kommen nicht mehr dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health holds more medications than HealthLog mirrors. The limit for mirrored medications is reached. Medications already mirrored keep syncing, new ones are no longer added."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health에 HealthLog가 미러링할 수 있는 것보다 많은 약이 있어요. 미러링할 수 있는 약의 한도에 도달했어요. 이미 미러링된 약은 계속 동기화되지만 새 약은 더 이상 추가되지 않아요."
          }
        }
      }
    },
    "settings.applehealth.medSync.issue.unstableExternalId": {
      "comment": "CU-10 — server refused an externalId as unstable (unstable_external_id)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Medikament aus Apple Health konnte nicht eindeutig zugeordnet werden und wurde nicht gespiegelt. Die Synchronisation läuft weiter. Bitte melde es, falls das bestehen bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A medication from Apple Health couldn't be identified reliably and was not mirrored. Syncing continues. Please report it if this persists."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health의 약 하나를 확실히 식별하지 못해 미러링하지 않았어요. 동기화는 계속돼요. 문제가 계속되면 신고해 주세요."
          }
        }
      }
    },
