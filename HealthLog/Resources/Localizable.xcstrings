            "value": "Anmeldung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인"
          }
        }
      }
    },
