    "health.permissions.control_body": {
      "comment": "v0.7.0 W-APPSTORE — user-control card body.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jeden Datentyp einzeln ändern oder den Zugriff vollständig widerrufen. Das geht in Apple Health über dein Profilbild > Datenschutz > Apps > HealthLog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change each data type individually or revoke access entirely. In Apple Health, go to your profile picture > Privacy > Apps > HealthLog."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 유형별로 변경하거나 접근 권한을 완전히 철회할 수 있어요. Apple Health에서 프로필 사진 > 개인정보 보호 > 앱 > HealthLog로 이동하세요."
          }
        }
      }
    },
    "health.permissions.control_footer": {
      "comment": "v0.7.0 W-APPSTORE — user-control card footer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog sendet Gesundheitsdaten nur an deinen eigenen Server und an Dienste, die du selbst einschaltest, etwa einen KI-Anbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog only sends health data to your own server and to services you turn on yourself, such as an AI provider."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog는 건강 데이터를 내 서버와 직접 켠 서비스(예: AI 제공자)에만 보내요."
          }
        }
      }
    },
    "health.permissions.control_title": {
      "comment": "v0.7.0 W-APPSTORE — user-control card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behältst die Kontrolle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stay in control"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 관리"
          }
        }
      }
    },
    "health.permissions.nav_row": {
      "comment": "v0.7.0 W-APPSTORE — Integrations row label opening the HealthKit access screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Health-Zugriff anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Apple Health access"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 접근 권한 보기"
          }
        }
      }
    },
    "health.permissions.read_empty": {
      "comment": "v0.7.0 W-APPSTORE — read section empty state.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ist auf diesem Gerät nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health is not available on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 Apple Health를 사용할 수 없어요."
          }
        }
      }
    },
    "health.permissions.read_subtitle": {
      "comment": "v0.7.0 W-APPSTORE — read section subtitle.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Werte liest HealthLog aus Apple Health. Ob du sie erlaubt hast, verrät Apple der App nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog reads these values from Apple Health. Apple doesn't tell the app whether you allowed them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog는 Apple Health에서 이 값들을 읽어요. Apple은 허용 여부를 앱에 알려 주지 않아요."
          }
        }
      }
