    "mfaEnroll.body": {
      "comment": "Forced-MFA gate — body explaining why the app is gated",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Konto ist ein zweiter Faktor erforderlich. Richte ihn ein, um HealthLog weiter zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account requires a second factor. Set one up to continue using HealthLog."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 2단계 인증이 필요해요. HealthLog를 계속 사용하려면 설정해 주세요."
          }
        }
      }
    },
    "mfaEnroll.enrollButton": {
