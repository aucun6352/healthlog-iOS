    "integration.sync.empty": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. outcome == empty: a completed run that found nothing new. A normal ending, never a failure.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig. Drüben gab es nichts Neues."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. There was nothing new over there."
          }
        },
        "ko": {
