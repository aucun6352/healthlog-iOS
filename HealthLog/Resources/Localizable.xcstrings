        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영양소 모듈이 꺼져 있는 동안 HealthLog는 Apple Health에 비타민, 미네랄, 수분, 카페인 데이터를 요청하지 않아요."
          }
