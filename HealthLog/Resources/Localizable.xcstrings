    "mentalHealth.optInNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freiwillig und privat: Deine einzelnen Antworten sind verschlüsselt, bleiben aus dem KI-Coach und aus Exporten heraus und werden nie geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opt-in and private: your individual answers are encrypted, kept out of the AI Coach and exports, and never shared."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이며 비공개예요. 개별 답변은 암호화되고, AI 코치와 내보내기에서 제외되며, 절대 공유되지 않아요."
          }
        }
      }
    },
