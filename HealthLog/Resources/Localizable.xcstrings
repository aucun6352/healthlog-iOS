    "mentalHealth.items.gad7.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nervosität, Ängstlichkeit oder Anspannung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling nervous, anxious, or on edge"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초조하거나 불안하거나 조마조마하게 느낀다"
          }
        }
      }
    },
    "mentalHealth.items.gad7.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht in der Lage sein, Sorgen zu stoppen oder zu kontrollieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not being able to stop or control worrying"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걱정하는 것을 멈추거나 조절할 수가 없다"
          }
        }
      }
    },
    "mentalHealth.items.gad7.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übermäßige Sorgen bezüglich verschiedener Angelegenheiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worrying too much about different things"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 가지 것들에 대해 걱정을 너무 많이 한다"
          }
        }
      }
    },
    "mentalHealth.items.gad7.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwierigkeiten zu entspannen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouble relaxing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편하게 있기가 어렵다"
          }
        }
      }
    },
    "mentalHealth.items.gad7.5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastlosigkeit, sodass Stillsitzen schwerfällt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Being so restless that it is hard to sit still"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 안절부절못해서 가만히 있기가 힘들다"
          }
        }
      }
    },
    "mentalHealth.items.gad7.6": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle Verärgerung oder Gereiztheit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becoming easily annoyed or irritable"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉽게 짜증이 나거나 쉽게 성을 내게 된다"
          }
        }
      }
    },
    "mentalHealth.items.gad7.7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefühl der Angst, als würde etwas Schlimmes passieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling afraid as if something awful might happen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마치 끔찍한 일이 생길 것처럼 두렵게 느껴진다"
          }
        }
      }
    },
    "mentalHealth.items.phq9.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Interesse oder Freude an Ihren Tätigkeiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little interest or pleasure in doing things"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일 또는 여가 활동을 하는 데 흥미나 즐거움을 느끼지 못함"
          }
        }
      }
    },
    "mentalHealth.items.phq9.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedergeschlagenheit, Schwermut oder Hoffnungslosigkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling down, depressed, or hopeless"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기분이 가라앉거나, 우울하거나, 희망이 없음"
          }
        }
      }
    },
    "mentalHealth.items.phq9.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwierigkeiten, ein- oder durchzuschlafen, oder vermehrter Schlaf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouble falling or staying asleep, or sleeping too much"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠이 들거나 계속 잠을 자는 것이 어려움, 또는 잠을 너무 많이 잠"
          }
        }
      }
    },
    "mentalHealth.items.phq9.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Müdigkeit oder Gefühl, keine Energie zu haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling tired or having little energy"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피곤하다고 느끼거나 기운이 거의 없음"
          }
        }
      }
    },
    "mentalHealth.items.phq9.5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminderter Appetit oder übermäßiges Bedürfnis zu essen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poor appetite or overeating"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입맛이 없거나 과식을 함"
          }
        }
      }
    },
    "mentalHealth.items.phq9.6": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Meinung von sich selbst; Gefühl, ein Versager zu sein oder die Familie enttäuscht zu haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling bad about yourself, or that you are a failure or have let yourself or your family down"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신을 부정적으로 봄, 혹은 자신이 실패자라고 느끼거나 자신 또는 가족을 실망시킴"
          }
        }
      }
    },
    "mentalHealth.items.phq9.7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwierigkeiten, sich auf etwas zu konzentrieren, z. B. beim Zeitunglesen oder Fernsehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouble concentrating on things, such as reading the newspaper or watching television"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신문을 읽거나 텔레비전 보는 것과 같은 일에 집중하는 것이 어려움"
          }
        }
      }
    },
    "mentalHealth.items.phq9.8": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waren Ihre Bewegungen oder Ihre Sprache so verlangsamt, dass es auch anderen auffallen würde? Oder waren Sie im Gegenteil „zappelig“ oder ruhelos und hatten einen stärkeren Bewegungsdrang als sonst?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving or speaking so slowly that other people could have noticed. Or the opposite: being so fidgety or restless that you have been moving around a lot more than usual"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람들이 주목할 정도로 너무 느리게 움직이거나 말을 함. 또는 반대로 평상시보다 많이 움직여서, 너무 안절부절 못하거나 들떠 있음"
          }
        }
      }
    },
    "mentalHealth.items.phq9.9": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedanken, dass Sie lieber tot wären oder sich Leid zufügen möchten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoughts that you would be better off dead, or of hurting yourself in some way"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신이 죽는 것이 더 낫다고 생각하거나 어떤 식으로든 자신을 해칠 것이라고 생각함"
          }
        }
      }
    },
    "mentalHealth.items.sci.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "… how long does it take you to fall asleep?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… how long does it take you to fall asleep?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "… 잠드는 데 얼마나 걸립니까?"
          }
        }
      }
    },
    "mentalHealth.items.sci.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "… if you then wake up during the night … how long are you awake for in total? (add all the wakenings up)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… if you then wake up during the night … how long are you awake for in total? (add all the wakenings up)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "… 그런 다음 밤중에 깨는 경우 … 모두 합해 얼마나 오래 깨어 있습니까? (깨어 있던 시간을 모두 더하십시오)"
          }
        }
      }
    },
    "mentalHealth.items.sci.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "… how many nights a week do you have a problem with your sleep?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… how many nights a week do you have a problem with your sleep?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "… 일주일에 며칠 밤 수면에 문제가 있습니까?"
          }
        }
      }
    },
    "mentalHealth.items.sci.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "… how would you rate your sleep quality?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… how would you rate your sleep quality?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "… 수면의 질을 어떻게 평가하시겠습니까?"
          }
        }
      }
    },
    "mentalHealth.items.sci.5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "… affected your mood, energy, or relationships?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… affected your mood, energy, or relationships?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "… 기분, 기력 또는 대인 관계에 어느 정도 영향을 주었습니까?"
          }
        }
      }
    },
    "mentalHealth.items.sci.6": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "… affected your concentration, productivity, or ability to stay awake?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… affected your concentration, productivity, or ability to stay awake?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "… 집중력, 생산성 또는 깨어 있는 능력에 어느 정도 영향을 주었습니까?"
          }
        }
      }
    },
    "mentalHealth.items.sci.7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "… troubled you in general?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
