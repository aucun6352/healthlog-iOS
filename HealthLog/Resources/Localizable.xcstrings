      }
    },
    "error.server.keyMismatch": {
      "comment": "503 encryption.key_mismatch (server v1.40): a server configuration problem, not offline",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server kann seine Daten gerade nicht entschlüsseln. Bitte lass den Server-Betreiber prüfen, ob der Verschlüsselungsschlüssel stimmt. Was du hier einträgst, bleibt auf dem Gerät und wird später übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server can't decrypt its data right now. Please ask whoever runs the server to check that the encryption key is correct. What you enter here stays on this device and is sent later."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 서버가 데이터를 복호화할 수 없어요. 서버 운영자에게 암호화 키가 올바른지 확인해 달라고 요청해 주세요. 여기에 입력한 내용은 이 기기에 남아 있다가 나중에 전송돼요."
          }
        }
      }
    },
    "med.intake.error.notTracked": {
      "comment": "422 medication.intake.notTracked (server v1.42)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Medikament werden keine Einnahmen erfasst, darum wurde die Einnahme nicht gespeichert. Du kannst das Erfassen in den Einstellungen des Medikaments einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intake isn't tracked for this medication, so the dose wasn't saved. You can turn tracking on in the medication's settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 약은 복용 기록을 추적하지 않아서 복용 내역이 저장되지 않았어요. 약 설정에서 추적을 켤 수 있어요."
          }
        }
      }
    },
    "auth.passkey.error.challengeExpired": {
      "comment": "Passkey sign-in 401 passkey.challenge.expired (server v1.42)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hat zu lange gedauert. Bitte versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in took too long. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시간이 너무 오래 걸렸어요. 다시 시도해 주세요."
          }
        }
      }
    },
    "auth.passkey.error.unknownPasskey": {
      "comment": "Passkey sign-in 404 passkey.unknown (server v1.42)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server kennt den Passkey nicht. Bitte melde dich anders an, zum Beispiel mit deinem Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server doesn't know this passkey. Please sign in another way, for example with your password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에 등록되지 않은 패스키예요. 비밀번호 등 다른 방법으로 로그인해 주세요."
          }
        }
      }
    },
    "auth.passkey.error.responseInvalid": {
      "comment": "Passkey sign-in 422 passkey.response.invalid (server v1.42)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Passkeys war unvollständig. Bitte versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passkey's answer was incomplete. Please try again."
