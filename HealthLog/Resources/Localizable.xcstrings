    "illness.correlation.redFlags.seekCare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a pattern in your own recorded values, not a clinical finding. If it keeps happening, it is worth mentioning to your doctor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Muster in deinen eigenen Werten, kein klinischer Befund. Wenn es sich wiederholt, lohnt es sich, das ärztlich anzusprechen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 기록한 값에서 나타난 패턴이며 임상 소견이 아니에요. 계속 반복된다면 의사에게 이야기해 볼 만해요."
          }
        }
      }
    },
