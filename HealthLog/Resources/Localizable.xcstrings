    "integration.oauth.howItWorks": {
      "comment": "How-it-works explainer on the Oura/Polar/Fitbit OAuth integration detail screen — describes the server-brokered connect flow and where data flows.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du meldest dich im Browser beim Anbieter an, dein Passwort sieht HealthLog nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in with the provider in your browser, HealthLog never sees your password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 서비스 제공자에 로그인해요. HealthLog는 내 비밀번호를 절대 볼 수 없어요."
          }
        }
      }
    },
    "integration.sync.button": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. Button that asks the server to pull from the provider now.",
