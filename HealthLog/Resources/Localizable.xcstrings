        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 가장 기분 좋은 요일인 경향이 있어요 (다른 요일 %3$@ 대비 %2$@)."
          }
        }
      }
    },
    "mood.patterns.notesHigher %@ %@": {
