    "settings.coach.cadenceSuggestions.description": {
      "comment": "Settings → Coach — description of the proactive cadence-suggestions opt-in",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne deine Bestätigung wird nie eine Erinnerung erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reminder is ever created without your tap."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 탭하지 않으면 알림은 절대 만들어지지 않아요."
          }
        }
      }
    },
    "settings.coach.docsAutoAi.description": {
      "comment": "Settings → Coach — help text for the auto read-documents-with-AI switch",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine externe KI liest jedes hochgeladene Dokument und holt Laborwerte und eine kurze Zusammenfassung heraus. Einschalten ist deine dauerhafte Einwilligung, ausschalten geht jederzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your external AI reads each uploaded document and pulls out lab values and a short summary. Turning this on is your standing consent, and you can turn it off anytime."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 AI가 업로드된 문서를 하나씩 읽고 검사 수치와 짧은 요약을 추출해요. 이 기능을 켜면 계속 적용되는 동의로 간주되며, 언제든 끌 수 있어요."
          }
        }
      }
    },
    "settings.coach.docsAutoAi.toggle": {
      "comment": "Settings → Coach — label of the auto read-documents-with-AI toggle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Dokumente automatisch lesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read new documents automatically"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 문서 자동으로 읽기"
          }
        }
      }
    },
    "settings.coach.enable.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet den Coach auf allen deinen Geräten ein oder aus."
          }
