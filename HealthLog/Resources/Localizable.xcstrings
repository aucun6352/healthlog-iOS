    "onboarding.webLogin.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung über den Browser hat nicht geklappt. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in via the browser didn't work. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저로 로그인하지 못했어요. 다시 시도해 주세요."
          }
        }
      }
    },
    "onboarding.webLogin.error.invalidState": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung konnte nicht sicher zugeordnet werden. Bitte starte sie neu aus der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in couldn't be securely matched. Please start it again from the app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인을 안전하게 확인하지 못했어요. 앱에서 다시 시작해 주세요."
          }
        }
      }
    },
    "onboarding.webLogin.error.noSession": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Browser ist keine Anmeldung zustande gekommen. Bitte melde dich dort an und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sign-in was completed in the browser. Please sign in there and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 완료된 로그인이 없어요. 브라우저에서 로그인한 뒤 다시 시도해 주세요."
          }
        }
      }
    },
    "onboarding.webLogin.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche. Bitte warte einen Moment und versuche es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in attempts. Please wait a moment and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시도가 너무 많아요. 잠시 기다린 뒤 다시 시도해 주세요."
          }
        }
      }
    },
    "onboarding.webLogin.error.staleSession": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Browser-Anmeldung ist nicht frisch genug. Bitte melde dich im Browser neu an. Direkt danach übernimmt die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your browser sign-in isn't fresh enough. Please sign in again in the browser. The app takes over right after."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 로그인이 오래되었어요. 브라우저에서 다시 로그인해 주세요. 그러면 바로 앱으로 이어져요."
          }
        }
      }
    },
    "onboarding.webLogin.exchangeFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung konnte nicht abgeschlossen werden, weil der Anmeldecode nicht mehr gültig war. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in couldn't be completed because the sign-in code was no longer valid. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 코드가 더 이상 유효하지 않아 로그인을 완료하지 못했어요. 다시 시도해 주세요."
          }
        }
      }
    },
    "onboarding.webLogin.fallbackPassword": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattdessen mit Passwort in der App anmelden"
