    "mentalHealth.instrumentDescription.gad7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beziehe dich auf die letzten zwei Wochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer for the last two weeks."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 2주를 기준으로 답해 주세요."
          }
        }
      }
    },
    "mentalHealth.instrumentDescription.phq9": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beziehe dich auf die letzten zwei Wochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer for the last two weeks."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 2주를 기준으로 답해 주세요."
          }
        }
      }
    },
    "mentalHealth.instrumentDescription.sci": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Fragen beziehen sich auf den letzten Monat; höhere Werte bedeuten besseren Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most questions ask about the past month; higher scores mean better sleep."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 문항은 지난 한 달을 물어요. 점수가 높을수록 수면이 좋아요."
          }
        }
      }
    },
    "mentalHealth.instrumentDescription.who5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beziehe dich auf die letzten zwei Wochen; höhere Werte bedeuten besseres Wohlbefinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer for the last two weeks; higher numbers mean better well-being."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 2주를 기준으로 답해 주세요. 숫자가 클수록 웰빙이 좋아요."
          }
        }
      }
    },
