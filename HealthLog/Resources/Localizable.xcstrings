    "onboarding.webLogin.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Anmeldeseite im sicheren Browser, wo Passkeys und Passwort-Manager funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the sign-in page in a secure browser, where passkeys and password managers work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스키와 비밀번호 관리자를 쓸 수 있는 보안 브라우저에서 로그인 페이지를 열어요."
          }
        }
      }
    },
