    "settings.hkdiag.explainer_read": {
      "comment": "BF-5 — Explainer bullet for read counter.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelesen: wie viele Werte Apple Health seit dem App-Start gemeldet hat, ohne die, die HealthLog selbst geschrieben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read: how many values Apple Health has reported since the app started, not counting those HealthLog wrote itself."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽음: 앱 시작 후 Apple Health가 보고한 값의 수예요. HealthLog가 직접 쓴 값은 제외해요."
          }
        }
      }
    },
    "settings.hkdiag.explainer_title": {
      "comment": "BF-5 — Explainer card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Werte bedeuten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the counters mean"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운터의 의미"
          }
        }
      }
    },
    "settings.hkdiag.explainer_upload": {
      "comment": "BF-5 — Explainer bullet for upload counter.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragen: wie viele davon dein Server gespeichert hat, neu, geändert oder schon vorhanden. Übersprungene und geparkte Werte zählen hier nicht mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaded: how many of them your server stored, new, changed or already there. Skipped and parked values are not counted here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드됨: 그중 서버가 저장한 값의 수예요(신규, 변경, 기존 값 포함). 건너뛰거나 보류된 값은 여기서 세지 않아요."
          }
        }
      }
    },
