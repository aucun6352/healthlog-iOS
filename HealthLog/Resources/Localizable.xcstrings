    "deleteAccount.stepUp.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil dein Konto mit einem zweiten Faktor geschützt ist, muss die Löschung im Browser bestätigt werden. Dort werden dein Konto und alle Daten entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because your account is protected by a second factor, the deletion has to be confirmed in the browser. Your account and all data are removed there."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 2단계 인증으로 보호되어 있어서 삭제는 브라우저에서 확인해야 해요. 계정과 모든 데이터는 그곳에서 삭제돼요."
          }
        }
      }
    },
