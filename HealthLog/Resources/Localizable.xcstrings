    "integration.sync.rateLimited": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. 429 rate_limited_self, no reset time known. NOT an error tone — it says 'you just did' and names that it works again shortly.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hast du gerade eben schon gemacht. In etwa einer Minute geht es wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You just did that. It'll work again in about a minute."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 실행했어요. 1분쯤 뒤에 다시 할 수 있어요."
          }
        }
      }
    },
    "integration.sync.rateLimited.seconds": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. 429 rate_limited_self with a known reset; %lld is the wait in seconds.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hast du gerade eben schon gemacht. In %1$lld Sekunden geht es wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You just did that. It'll work again in %1$lld seconds."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 실행했어요. %1$lld초 뒤에 다시 할 수 있어요."
          }
        }
      }
    },
    "integration.sync.success %lld": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. outcome == success; the count is what the run actually imported.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Fertig! %lld neuer Eintrag übernommen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Fertig! %lld neue Einträge übernommen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Done. Imported %lld new entry."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Done. Imported %lld new entries."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "완료했어요. 새 항목 %lld개를 가져왔어요."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "완료했어요. 새 항목 %lld개를 가져왔어요."
                }
              }
            }
          }
        }
      }
    },
    "integration.sync.upstreamUnavailable": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. 502; %@ is the provider name. Names the provider as the place the fault sits, because the user cannot repair it and must not go looking.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gerade nicht geantwortet. Das liegt am Dienst dort drüben, nicht an dir und nicht an HealthLog. Probier es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ didn't answer just now. That's their service, not you and not HealthLog. Try again later."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 지금 응답이 없어요. 내 문제도 HealthLog 문제도 아니고 해당 서비스 쪽 문제예요. 잠시 후 다시 시도해 주세요."
          }
        }
      }
    },
