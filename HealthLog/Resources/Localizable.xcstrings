    "correlations.bpMedication.lowerOnIntakeDays": {
      "comment": "1.0.3 (App Review 1.4.1) — BP x medication: association-only wording, no drug-effect claim.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Tagen mit erfasster Einnahme waren deine Blutdruckwerte etwas niedriger. Das vergleicht deine eigenen Tage miteinander und kann nicht zeigen, ob das Medikament die Ursache ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On days you logged an intake, your blood pressure readings were slightly lower. This compares your own days with each other and cannot show whether the medicine caused it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용을 기록한 날에는 혈압 측정값이 약간 낮았어요. 이는 내 날짜끼리 비교한 것이며, 약 때문인지는 알 수 없어요."
          }
        }
      }
    },
    "correlations.bpMedication.noDifference": {
      "comment": "1.0.3 (App Review 1.4.1) — BP x medication, no-difference case: association-only wording, no drug-effect claim.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Werte an Einnahme- und anderen Tagen sehen etwa gleich aus. Das ist ein Vergleich deiner eigenen Tage, keine Aussage über das Medikament."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your readings on intake days and other days look about the same. That is a comparison of your own days, not a statement about the medicine."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용한 날과 다른 날의 측정값이 거의 같아 보여요. 내 날짜끼리 비교한 것이며, 약에 대한 판단이 아니에요."
          }
        }
      }
    },
    "insights.metric.statusCard.notADiagnosis": {
      "comment": "1.0.3 (App Review 1.4.1) — caption under the BP/BMI classification chip on the canonical metric status card.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie aus deinen Heimmessungen, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category from your home readings, not a diagnosis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가정 측정값으로 정한 분류이며, 진단이 아니에요."
          }
        }
      }
    },
    "coach.filtered.refusal": {
      "comment": "1.4.1 R19a — shown instead of an assistant reply the MDR output filter held back",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Antwort wurde zurückgehalten, weil sie wie ein medizinischer Rat klang, und den gibt der Assistent nicht. Deine Frage ist in Ordnung: Frag, was deine Werte zeigen, oder nimm sie mit zu Ärztin oder Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This answer was held back because it read like medical advice, which the assistant does not give. Your question is fine. Try asking what your values show, or bring it to your doctor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의학적 조언처럼 읽혀서 이 답변을 보류했어요. 어시스턴트는 의학적 조언을 하지 않아요. 질문 자체는 괜찮아요. 내 값이 무엇을 보여 주는지 물어보거나, 의사와 상담해 보세요."
          }
        }
      }
    },
